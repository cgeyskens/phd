// nextflow.config

// conda environment
conda.enabled = true
process.conda = "/Users/cgeyskens/miniconda3/envs/image-analysis"

// parameters
params {
    // input directory
    input_dir = "/Volumes/KINGSTON/data/phd/image-analysis/synapse-counting/GPR37L1/GPR37L1-LacZ_VGLUT1-PSD95_images"
    
    // intermediate directory
    intermediate_dir = "/Volumes/KINGSTON/data/phd/image-analysis/synapse-counting/GPR37L1/GPR37L1-LacZ_VGLUT1-PSD95_intermediate_data"
    
    // output directory
    output_dir = "/Volumes/KINGSTON/data/phd/image-analysis/synapse-counting/GPR37L1/GPR37L1-LacZ_VGLUT1-PSD95_output_data"
    
    // important segments of the filename, that is needed for the analysis, separated by "_".
    // example: CRISPR-Exp4_IHC-Exp2_Brain-4_section-1_488-VGLUT1_647-PSD95_LacZ-gRNA_63X&3XzoomAiryscan_CA1_SLM.czi
    // we take from this 
    // [0] = CRISPR-Exp4, 
    // [1] = IHC-Exp2, 
    // [2] = Brain-4, 
    // [3] = section-1, 
    // [6] = LacZ-gRNA, 
    // [8] = CA1, 
    // [9] = SLM
    name_segments = "0 1 2 3 6 8 9"
}
